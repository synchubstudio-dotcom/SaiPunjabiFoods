# ========================================================
# SAI PUNJABI - MONOREPO ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env in root or specific apps as needed
# ========================================================

# Application Configuration
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/sai_punjabi?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=replace_with_a_super_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d
COOKIE_NAME=sai_punjabi_token
COOKIE_SECRET=replace_with_a_secure_cookie_signing_secret

# Initial Admin Bootstrap (Used by seed script / first run)
ADMIN_NAME="Sai Punjabi Administrator"
ADMIN_EMAIL=admin@saipunjabifoods.com
ADMIN_PASSWORD=ChangeMeImmediately123!
ADMIN_PHONE=+919876543210

# Cloudinary (Image Uploads - optional local fallback enabled)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Payments in INR - test mode enabled by default)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_key

# Restaurant Settings Defaults
RESTAURANT_NAME="Sai Punjabi"
RESTAURANT_TAGLINE="Authentic Amritsari & Punjabi Cuisine"
RESTAURANT_PHONE="+91 98765 43210"
RESTAURANT_EMAIL="hello@saipunjabifoods.com"
RESTAURANT_ADDRESS="Plot 42, Punjabi Bagh Main Market, New Delhi, India"
TAX_RATE_PERCENTAGE=5.0
DELIVERY_FEE_DEFAULT=40.0
FREE_DELIVERY_THRESHOLD=499.0
CASH_ON_DELIVERY_ENABLED=true
